OPENROUTER_API_KEY=
KB_API_KEY=generate-with-openssl-rand-hex-24
KB_PASSWORD=generate-with-openssl-rand-hex-24
DEMO_PASSWORD=careops-demo
DEFAULT_MODEL=openai/gpt-5.4-mini
DAILY_BUDGET_USD=3
PUBLIC_HOST=careops.shawndemos.com
# optional: answer on several hostnames (Traefik v3 rule syntax)
